{
  "manifest_version": 3,
  "name": "GulRating — прогресс плееров",
  "version": "1.2.0",
  "description": "Сохраняет и восстанавливает позицию просмотра в поддерживаемых плеерах GulRating.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://stravers.live/*",
    "https://*.stravers.live/*",
    "https://alloha.tv/*",
    "https://*.alloha.tv/*",
    "https://alloha.cool/*",
    "https://*.alloha.cool/*",
    "https://obrut.show/*",
    "https://*.obrut.show/*",
    "https://kodik.info/*",
    "https://*.kodik.info/*",
    "https://kodik.cc/*",
    "https://*.kodik.cc/*",
    "https://kodik.club/*",
    "https://*.kodik.club/*",
    "https://kodik.ws/*",
    "https://*.kodik.ws/*",
    "https://videocdn.net/*",
    "https://*.videocdn.net/*",
    "https://videocdn.tv/*",
    "https://*.videocdn.tv/*",
    "https://collaps.me/*",
    "https://*.collaps.me/*",
    "https://collaps.so/*",
    "https://*.collaps.so/*",
    "https://bazon.cc/*",
    "https://*.bazon.cc/*",
    "https://hdzo.fun/*",
    "https://*.hdzo.fun/*",
    "https://kurolesya.link/*",
    "https://*.kurolesya.link/*",
    "https://nextembed.ws/*",
    "https://*.nextembed.ws/*",
    "https://kinokino.vip/*",
    "https://*.kinokino.vip/*",
    "https://kinobox.tv/*",
    "https://*.kinobox.tv/*",
    "https://vidlink.pro/*",
    "https://*.vidlink.pro/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://stravers.live/*",
        "https://*.stravers.live/*",
        "https://alloha.tv/*",
        "https://*.alloha.tv/*",
        "https://alloha.cool/*",
        "https://*.alloha.cool/*",
        "https://obrut.show/*",
        "https://*.obrut.show/*",
        "https://kodik.info/*",
        "https://*.kodik.info/*",
        "https://kodik.cc/*",
        "https://*.kodik.cc/*",
        "https://kodik.club/*",
        "https://*.kodik.club/*",
        "https://kodik.ws/*",
        "https://*.kodik.ws/*",
        "https://videocdn.net/*",
        "https://*.videocdn.net/*",
        "https://videocdn.tv/*",
        "https://*.videocdn.tv/*",
        "https://collaps.me/*",
        "https://*.collaps.me/*",
        "https://collaps.so/*",
        "https://*.collaps.so/*",
        "https://bazon.cc/*",
        "https://*.bazon.cc/*",
        "https://hdzo.fun/*",
        "https://*.hdzo.fun/*",
        "https://kurolesya.link/*",
        "https://*.kurolesya.link/*",
        "https://nextembed.ws/*",
        "https://*.nextembed.ws/*",
        "https://kinokino.vip/*",
        "https://*.kinokino.vip/*",
        "https://kinobox.tv/*",
        "https://*.kinobox.tv/*",
        "https://vidlink.pro/*",
        "https://*.vidlink.pro/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "alloha-progress@gulrating.pages.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": []
      }
    }
  }
}
